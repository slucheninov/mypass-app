{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyPass",
  "version": "0.1.0",
  "identifier": "com.mypass.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyPass",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "visible": false
      },
      {
        "label": "tray-panel",
        "title": "MyPass",
        "width": 320,
        "height": 440,
        "decorations": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": true
    }
  }
}
