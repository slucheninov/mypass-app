{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Permissions of the main window (events, its own window controls and the minimised query that hides revealed secrets, the vault open and save dialogs, http(s) links). No fs, shell, http or clipboard access; shortcuts are registered from Rust only.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "core:window:allow-is-minimized",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    },
    "allow-app-info",
    "allow-app-open-settings",
    "allow-app-record-activity",
    "allow-app-set-editor-dirty",
    "allow-attachment-export",
    "allow-attachment-pick",
    "allow-browser-pairing-cancel",
    "allow-browser-proposal-take",
    "allow-browser-status",
    "allow-device-unlock-consume-extension-request",
    "allow-device-unlock-status",
    "allow-draft-clear",
    "allow-draft-save",
    "allow-draft-versions",
    "allow-entry-copy",
    "allow-entry-delete",
    "allow-entry-edit-model",
    "allow-entry-empty-bin",
    "allow-entry-get",
    "allow-entry-history",
    "allow-entry-history-restore",
    "allow-entry-list",
    "allow-entry-move",
    "allow-entry-new-model",
    "allow-entry-passkey-details",
    "allow-entry-purge",
    "allow-entry-restore",
    "allow-entry-reveal",
    "allow-entry-save",
    "allow-entry-set-favorite",
    "allow-entry-totp",
    "allow-generator-copy",
    "allow-generator-generate",
    "allow-generator-history-copy",
    "allow-generator-history-delete",
    "allow-generator-history-list",
    "allow-generator-history-reveal",
    "allow-generator-rules-summary",
    "allow-group-create",
    "allow-group-delete",
    "allow-group-move",
    "allow-group-update",
    "allow-import-csv-commit",
    "allow-import-csv-preview",
    "allow-platform-keyboard-layout",
    "allow-settings-get",
    "allow-settings-update",
    "allow-shortcut-conflicts-take",
    "allow-sidebar-get",
    "allow-sync-status",
    "allow-update-dismiss",
    "allow-update-open-release",
    "allow-update-status",
    "allow-vault-create",
    "allow-vault-find-files",
    "allow-vault-forget",
    "allow-vault-lock",
    "allow-vault-open",
    "allow-vault-open-warnings",
    "allow-vault-recent",
    "allow-vault-status",
    "allow-vault-storage-status",
    "allow-vault-unlock",
    "allow-vault-unlock-device"
  ]
}
