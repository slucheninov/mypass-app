{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tray-panel",
  "description": "Permissions of the tray panel: events and only the app commands used by its compact UI. The tray and its menus are built from Rust.",
  "windows": ["tray-panel"],
  "permissions": [
    "core:event:default",
    "allow-app-info",
    "allow-app-open-entry",
    "allow-app-open-settings",
    "allow-app-quit",
    "allow-app-record-activity",
    "allow-app-show-main",
    "allow-device-unlock-status",
    "allow-entry-copy",
    "allow-entry-get",
    "allow-entry-recent",
    "allow-entry-reveal",
    "allow-entry-totp",
    "allow-entry-touch",
    "allow-settings-get",
    "allow-update-open-release",
    "allow-update-status",
    "allow-vault-lock",
    "allow-vault-status",
    "allow-vault-unlock",
    "allow-vault-unlock-device"
  ]
}
