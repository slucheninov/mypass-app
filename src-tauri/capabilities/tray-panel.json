{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tray-panel",
  "description": "Permissions of the tray panel: events and only the app commands used by its recents, copy actions and unlock card. The tray and its menus are built from Rust.",
  "windows": ["tray-panel"],
  "permissions": [
    "core:event:default",
    "allow-app-info",
    "allow-app-open-settings",
    "allow-app-quit",
    "allow-app-record-activity",
    "allow-app-show-main",
    "allow-device-unlock-status",
    "allow-entry-copy",
    "allow-entry-recent",
    "allow-entry-touch",
    "allow-platform-keyboard-layout",
    "allow-settings-get",
    "allow-tray-panel-fit",
    "allow-tray-panel-hide",
    "allow-update-open-release",
    "allow-update-status",
    "allow-vault-lock",
    "allow-vault-status",
    "allow-vault-unlock",
    "allow-vault-unlock-device"
  ]
}
