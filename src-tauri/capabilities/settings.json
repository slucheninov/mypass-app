{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Permissions of the settings window: events, the open and save dialogs that pick the vault path and the secondary folder, and the official help pages of the Browser pane (four exact hosts, https only). No fs, shell, http or clipboard access.",
  "windows": ["settings"],
  "permissions": [
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://support.google.com/*" },
        { "url": "https://bitwarden.com/*" },
        { "url": "https://support.1password.com/*" },
        { "url": "https://support.apple.com/*" }
      ]
    },
    "allow-app-info",
    "allow-app-record-activity",
    "allow-app-reveal-backups",
    "allow-backup-list",
    "allow-backup-restore",
    "allow-browser-reinstall-host",
    "allow-browser-reset-pairings",
    "allow-browser-revoke",
    "allow-browser-show-extension-folder",
    "allow-browser-status",
    "allow-browser-unregister-host",
    "allow-device-unlock-configure",
    "allow-device-unlock-status",
    "allow-settings-get",
    "allow-settings-login-item-status",
    "allow-settings-update",
    "allow-sync-connect-secondary",
    "allow-sync-disconnect-secondary",
    "allow-sync-now",
    "allow-sync-status",
    "allow-update-check-now",
    "allow-update-open-release",
    "allow-update-status",
    "allow-vault-location-change",
    "allow-vault-location-pick",
    "allow-vault-location-probe",
    "allow-vault-status",
    "allow-vault-storage-status"
  ]
}
