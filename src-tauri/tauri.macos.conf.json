{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyPass",
        "width": 1080,
        "height": 720,
        "minWidth": 820,
        "minHeight": 520,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        }
      },
      {
        "label": "tray-panel",
        "title": "MyPass",
        "width": 300,
        "height": 360,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Utility",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true,
      "signingIdentity": null,
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "resources/macos/en.lproj/InfoPlist.strings",
        "Resources/uk.lproj/InfoPlist.strings": "resources/macos/uk.lproj/InfoPlist.strings",
        "Resources/ru.lproj/InfoPlist.strings": "resources/macos/ru.lproj/InfoPlist.strings",
        "Resources/de.lproj/InfoPlist.strings": "resources/macos/de.lproj/InfoPlist.strings"
      }
    }
  }
}
